# =================================================================
# .env.example — VibeCloud SaaS Environment Variables Configuration
# =================================================================

# ── 1. SEGURIDAD OBLIGATORIA (No usar valores por defecto en producción) ──
SECRET_KEY=cambiar_este_secreto_por_un_hash_seguro_32_caracteres
VIBECLOUD_FERNET_KEY=FernetKeyParaCifradoDeApiKeys==
ADMIN_EMAIL=admin@vibecloud.com
ADMIN_PASSWORD=PasswordSeguroInicial123!

# ── 2. ENTORNO Y BASE DE DATOS ──
# ENVIRONMENT: "development" o "production"
ENVIRONMENT=development
# DATABASE_URL: Obligatoria en producción. Formato PostgreSQL: postgresql://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./test.db

# ── 3. SERVICIOS DE INTELIGENCIA ARTIFICIAL ──
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere
AI_RATE_LIMIT_PER_HOUR=20
# ANTHROPIC_API_KEY: console.anthropic.com -> API Keys. Proveedor primario
# de la cascada de generación de contenido web (Landing/Ecommerce, Fase 5):
# Claude -> Gemini -> Qwen. Opcional -- si no está seteada, la cascada salta
# directo a Gemini (que ya se usaba antes de esta fase).
ANTHROPIC_API_KEY=tu_api_key_de_anthropic
# QWEN_API_KEY: DashScope (Alibaba Cloud) -> API Keys. Usada por
# services/ai_gateway_service.py para recomendación predictiva de productos
# en el ecommerce, como tercer fallback de la cascada de generación de
# contenido (Claude->Gemini->Qwen), y como fallback del chat de AlexIO
# (Gemini->Qwen) -- todo Fase 5. Opcional en los tres casos: sin ella, la
# recomendación cae a una heurística simple y los fallbacks simplemente no
# están disponibles, sin romper el resto del sitio.
QWEN_API_KEY=tu_api_key_de_dashscope

# ── 3.5. CONFIRMACIÓN DE CUENTA POR EMAIL (opcional) ──
# Sin SMTP_HOST configurada, /registro funciona como siempre (cuenta activa
# al toque, sin este paso). Con ella, el admin creado en el signup arranca
# inactivo hasta que confirma un link mandado a su email (vence en 24hs).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@vibecloud.online

# ── 4. CONTROL DE CORS Y RATE LIMITING GLOBAL ──
# CORS_ORIGINS: Lista separada por comas. En producción no debe incluir localhost
CORS_ORIGINS=https://vibecloud-frontend.onrender.com,https://vibecloud.onrender.com
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_PUBLIC=30/minute

# ── 5. DOMINIOS (compra y verificación desde SuperAdmin) ──
# GODADDY_API_KEY / GODADDY_API_SECRET: developer.godaddy.com -> My Apps -> Production key
# (actualización 2026-08-11: reemplaza a NameSilo/Dynadot como proveedor principal)
GODADDY_API_KEY=tu_api_key_de_godaddy
GODADDY_API_SECRET=tu_api_secret_de_godaddy
# Datos de contacto usados en la compra de dominios (GoDaddy los exige para
# registrant/admin/billing/tech -- ver services/domain_registrar_service.py)
GODADDY_CONTACT_FIRST_NAME=
GODADDY_CONTACT_LAST_NAME=
GODADDY_CONTACT_EMAIL=
GODADDY_CONTACT_PHONE=
GODADDY_CONTACT_ADDRESS=
GODADDY_CONTACT_CITY=
GODADDY_CONTACT_STATE=
GODADDY_CONTACT_POSTAL_CODE=
GODADDY_CONTACT_COUNTRY=
# BASE_DOMAIN: dominio raíz de la plataforma para subdominios de tenants (ej. acme.tudominio.com)
BASE_DOMAIN=tudominio.com
